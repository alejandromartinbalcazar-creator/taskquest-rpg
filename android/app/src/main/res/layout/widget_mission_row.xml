  <TextView android:id="@+id/widget_row_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="44dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" />
